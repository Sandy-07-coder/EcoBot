# ═══════════════════════════════════════════════════════════════════════════
# EcoDrawer - E-Waste Awareness WhatsApp Bot Configuration
# ═══════════════════════════════════════════════════════════════════════════

# ── Server Configuration ────────────────────────────────────────────────────
PORT=3000

# ── MongoDB Database ────────────────────────────────────────────────────────
# MongoDB connection string
# Local: mongodb://localhost:27017/ecodrawer
# Atlas: mongodb+srv://username:password@cluster.mongodb.net/ecodrawer
MONGODB_URI=mongodb://localhost:27017/ecodrawer

# ── Meta WhatsApp Cloud API ─────────────────────────────────────────────────
# Webhook verification token (set this to any secret string you choose)
# Must match what you enter in Meta Developer Portal
VERIFY_TOKEN=your_webhook_verify_token_here

# WhatsApp API Access Token
# Found in Meta Developer Portal → WhatsApp → API Setup → Temporary/Permanent Access Token
WHATSAPP_TOKEN=your_whatsapp_access_token_here

# Phone Number ID
# Found in Meta Developer Portal → WhatsApp → API Setup → Phone Number ID
PHONE_NUMBER_ID=your_phone_number_id_here

# ── Groq AI API ─────────────────────────────────────────────────────────────
# Groq API Key (get from https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# Groq Text Model (for conversations, lessons, translations)
# Recommended: llama-3.3-70b-versatile, llama-3.1-70b-versatile, mixtral-8x7b-32768
GROQ_MODEL=llama-3.3-70b-versatile

# Groq Vision Model (for image identification - optional)
# If available: llama-3.2-90b-vision-preview, llava-v1.5-7b-4096-preview
# Leave empty if vision model is not available
GROQ_VISION_MODEL=
